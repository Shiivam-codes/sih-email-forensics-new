APP_ENVIRONMENT=development
APP_DATABASE_PATH=data/analyses.db
APP_MAX_UPLOAD_BYTES=15728640
APP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

APP_ENRICHMENT_ENABLED=true
APP_OFFLINE_MODE=false
APP_CACHE_PATH=data/cache
APP_GEOIP_CITY_PATH=data/geoip/dbip-city-lite.mmdb
APP_GEOIP_ASN_PATH=data/geoip/dbip-asn-lite.mmdb
APP_DNS_TIMEOUT_SECONDS=3.0
APP_HTTP_TIMEOUT_SECONDS=4.0
APP_DAILY_EXTERNAL_REQUEST_LIMIT=500
APP_MAX_IP_LOOKUPS=3
APP_MAX_DOMAIN_LOOKUPS=4
APP_MAX_URL_LOOKUPS=5
APP_RDAP_ENABLED=true
APP_INTERNETDB_ENABLED=true
APP_TOR_EXIT_LIST_ENABLED=true

APP_SCORING_ENABLED=true
APP_SCORING_VERSION=phase3-rules-v1
APP_MALICIOUS_THRESHOLD=70
APP_SUSPICIOUS_THRESHOLD=40
APP_FAMILY_MIN_POINTS=5
APP_AUTH_SIGNAL_MAX=25
APP_DOMAIN_SIGNAL_MAX=20
APP_IP_SIGNAL_MAX=20
APP_CONTENT_SIGNAL_MAX=20
APP_HEADER_SIGNAL_MAX=15
